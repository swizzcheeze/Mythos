# Mythos Backend — AMD ROCm
# For Linux users with AMD GPUs. ROCm is NOT supported on Windows.
# Requires ROCm-compatible GPU (RX 5000/6000/7000 series, Instinct series).
# See: https://rocm.docs.amd.com/projects/install-on-linux/en/latest/
#
# Port is configurable via MYTHOS_PORT env var (default: 8013).
FROM rocm/pytorch:rocm6.2.3_ubuntu22.04_py3.10_ubuntu22.04

# Install Python 3.11 (base image ships 3.10)
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for python and pip
RUN rm -f /usr/bin/python /usr/bin/pip && \
    ln -s /usr/bin/python3.11 /usr/bin/python && \
    ln -s /usr/bin/pip3 /usr/bin/pip

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV MYTHOS_PORT=8013
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV TORCH_NUM_THREADS=1
# Tell PyTorch to use ROCm
ENV HSA_OVERRIDE_GFX_VERSION=10.3.0

# Set the working directory inside the container
WORKDIR /app

# Copy and install dependencies
COPY mythos_backend/requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy the application package
COPY mythos_backend/ ./mythos_backend/

# Run on the port configured via MYTHOS_PORT
CMD ["sh", "-c", "uvicorn mythos_backend.main:app --host 0.0.0.0 --port ${MYTHOS_PORT:-8013} --workers 1 --no-access-log"]
