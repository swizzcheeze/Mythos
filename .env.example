# Mythos World Engine - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================
# LLM Provider Configuration
# ============================================

# Choose your LLM provider: "ollama", "anthropic", "openrouter", "groq", "xai", "gemini"
# All providers are pre-installed - switch anytime without rebuilding!
MYTHOS_LLM_PROVIDER=ollama

# ============================================
# Anthropic Claude Configuration
# ============================================

# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Available models:
# - claude-3-5-sonnet-20241022 (Default - Best balance)
# - claude-3-7-sonnet-20250219 (Latest - Improved reasoning)
# - claude-3-opus-20240229 (Highest quality)
# - claude-3-5-haiku-20241022 (Fast & economical)
# MYTHOS_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# OpenRouter Configuration
# ============================================

# Get your API key from: https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Popular models:
# - anthropic/claude-3.5-sonnet (Default)
# - google/gemini-pro-1.5
# - openai/gpt-4-turbo
# - meta-llama/llama-3.1-70b-instruct
# MYTHOS_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ============================================
# Groq Configuration (Fast Inference)
# ============================================

# Get your API key from: https://console.groq.com/
# GROQ_API_KEY=gsk_your-key-here

# Available models:
# - llama-3.3-70b-versatile (Default - Best balance)
# - llama-3.1-70b-versatile
# - mixtral-8x7b-32768
# - gemma2-9b-it
# MYTHOS_GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# xAI (Grok) Configuration
# ============================================

# Get your API key from: https://console.x.ai/
# XAI_API_KEY=xai-your-key-here

# Available models:
# - grok-beta (Default)
# MYTHOS_XAI_MODEL=grok-beta

# ============================================
# Google Gemini Configuration
# ============================================

# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=AIzaSy-your-key-here

# Available models:
# - gemini-1.5-pro (Default - Best quality)
# - gemini-1.5-flash (Fast & economical)
# - gemini-2.0-flash-exp (Latest experimental)
# MYTHOS_GEMINI_MODEL=gemini-1.5-pro

# ============================================
# Ollama Configuration (Local Models)
# ============================================

# Ollama server URL (default works for Docker Desktop on Windows)
# MYTHOS_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default Ollama model (make sure it's pulled locally)
# MYTHOS_OLLAMA_MODEL=llama3

# ============================================
# Advanced Model Configuration
# ============================================

# Override models for specific tasks (optional)
# MYTHOS_GENERATOR_MODEL=claude-3-opus-20240229
# MYTHOS_CRITIC_MODEL=claude-3-5-haiku-20241022

# ============================================
# Embedding Service Configuration
# ============================================

# External embedding service URL (for semantic search)
# EMBEDDING_SERVICE_URL=http://host.docker.internal:8002

# Optional: Cohere API key for cloud embeddings
# COHERE_API_KEY=your-cohere-key-here

# ============================================
# Admin & Security
# ============================================

# Optional: Admin token for destructive operations
# If not set, admin operations are unrestricted (not recommended for production)
# MYTHOS_ADMIN_TOKEN=your-secure-random-token-here

# Suppress /healthz endpoint logs (1=mute, 0=show)
# MYTHOS_MUTE_HEALTHZ_LOGS=1

# ============================================
# Quick Start Examples
# ============================================

# Example 1: Use Anthropic Claude (best quality, direct API)
# MYTHOS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Example 2: Use OpenRouter (access 200+ models with one API key)
# MYTHOS_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# MYTHOS_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Example 3: Use Groq (blazing fast inference)
# MYTHOS_LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_your-key-here

# Example 4: Use xAI Grok (latest from X/Twitter)
# MYTHOS_LLM_PROVIDER=xai
# XAI_API_KEY=xai-your-key-here

# Example 5: Use Google Gemini (multimodal capable)
# MYTHOS_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy-your-key-here

# Example 6: Use local Ollama (free, private, offline)
# MYTHOS_LLM_PROVIDER=ollama
# MYTHOS_OLLAMA_MODEL=llama3

# Example 7: Mix providers (Opus for generation, Groq for fast critique)
# MYTHOS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# MYTHOS_GENERATOR_MODEL=claude-3-opus-20240229
# MYTHOS_CRITIC_MODEL=llama-3.3-70b-versatile  # Note: This would need Groq as provider
